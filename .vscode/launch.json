{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "cli",
            "type": "lldb",
            "sourceLanguages": ["rust"],
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/target/debug/tindalwic-cli",
            "args": ["random", "--check=10"],
            "preLaunchTask": "just: cli",
            "request": "launch",
        },
        {
            "name": "lezer",
            "type": "node",
            "cwd": "${workspaceFolder}/grammar",
            "program": "${workspaceFolder}/grammar/main.ts",
            "args": ["#F\n{ONE}\n\t#1\n{TWO}\n\t#T\n"],
            "env": {"LOG":"parse"},
            "request": "launch",
            "skipFiles": [
                "<node_internals>/**"
            ],
        },
    ]
}
