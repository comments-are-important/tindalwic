// Tindalwic is:

text {( indentT Line* dedent )?}

// in Nested

Dict {( indentD Prolog? Entry* dedent )?}
List {( indentL Prolog? Item* dedent )?}

// with Important

Comment { "//" Line text } // keys
Prolog { "#" Line text }   // File Dict List
Epilog { "#" Line text }   // Text Dict List
Shebang { "#!" Line text } // File

// Each comment is GFM and has a specific subject they are about.
// Note the possible subjects listed here match the Rust API, and that
// these rules attach some comments incorrectly to accommodate LR parsing.

// The outermost non-nested context is a Dict but with different comments:
@top File { Shebang? Prolog? Entry* }

// The aggregate contexts are arrays, so keys can repeated.
Item { ( value | Line ) Epilog? }
Entry { Comment? keyValue Epilog? }

// Brackets surround keys but indicate value type.
// Keys can be empty, and in a List they all must be.
value {
    "<>" eol Text
  | "{}" eol Dict
  | "[]" eol List
}
keyValue {
    "<" KeyText ">" eol Text
  | "{" KeyDict "}" eol Dict
  | "[" KeyList "]" eol List

// Keys can span multiple lines.
  | "@" eol KeyLong { text } value

// There are shortcuts available when a Text value only has one Line:
  | KeyShort eq Line // The other shortcut is above, in the List Item rule.
}

// Most of the tokens are irregular or difficult to express here:
@external tokens terms from "./lexical.ts" {
    // RESERVED  # / @ { } [ ] < >
    Line // { ![\n]* eol } except in ListContext 1st char can't be RESERVED
    eq // { "=" } - has to be here because of lezer token precedence
    KeyShort // { ![=\n]* } except 1st char can't be RESERVED
    KeyText // { ![\n]* } but don't grab the angle ket at the end
    KeyDict // { ![\n]* } but don't grab the curly ket at the end
    KeyList // { ![\n]* } but don't grab the square ket at the end
    eol // { "\n" | @eof } must have lower precedence than Line
    // these help lezer keep track of the indentation
    dedent indentT indentD indentL margin
}
@tokens {}
Text { text } // capitalization affects tree building in lezer
@skip { margin } // note that the Rust parser tracks gaps but lezer doesn't
@context margin from "./context.ts"
@external propSource highlight from "./properties.ts"
