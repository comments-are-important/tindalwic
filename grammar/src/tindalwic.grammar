// Tindalwic is:

Text { ( block )? }
block { indentT Line+ dedent }

// in Nested

Dict { ( indentD Prolog? Entry* dedent )? }
List { ( indentL Prolog? Item* dedent )? }

// with Important

Comment { "///" GFM } // Key
Prolog { "//" GFM }   // File Dict List
Epilog { "//" GFM }   // Text Dict List
// Every comment has a specific subject. The Rust API/parser differs:
//  + unified `struct Comment` tracks preceding gaps that are `@skip`ped here.
//  + subjects are sometimes at another nesting level, and Rust reshapes the tree
//      (e.g. it moves epilogs to be inside their Text/Dict/List structs).

// Both nesting contexts are arrays where each key/value can be subject of a comment:
Item { ( value | OneLine ) Epilog? }
Entry { Comment? keyValue Epilog? }

// The outermost context is a zero-indent dictionary and may begin with a "#!".
@top File { Shebang? Prolog? Entry* }

// Brackets surround keys and indicate type for the following value.
// Keys can repeat and can be empty (a List can be viewed as having only empty keys).
value {
    "<>" eol Text
  | "{}" eol Dict
  | "[]" eol List
}
keyValue {
    "<" KeyText ">" eol Text
  | "{" KeyDict "}" eol Dict
  | "[" KeyList "]" eol List

  // There is a shortcut available when a Text value only has OneLine:
  | KeyShort "=" OneLine

  // Keys can span multiple lines using an indented block before the value:
  | "@" eol KeyBlock value
}

// The OneLine shortcuts produce nodes named (and shaped like) `Text`:
OneLine[@name=Text] { Line }

// Comments are all Github Flavored Markdown, while Shebang is plain text.
GFM { Line block? }
Shebang { "#!" Interpreter block? }
Interpreter { Line }

// Most of the tokens are tricky/impossible to express here:
@external tokens terms from "./lexical.ts" {
  dedent indentT indentD indentL margin // fairly typical indentation mechanism
  eol // { "\n" | @eof } overlaps and defers to Line

  // RESERVED  # / @ { } [ ] < >
  Line // { ![\n]* eol } except in ListContext 1st char can't be RESERVED
  keyShort[@name=Line] // { ![=\n]* } except 1st char can't be RESERVED

  keyText[@name=Line] // { ![\n]* } excluding the angle ket at eol
  keyDict[@name=Line] // { ![\n]* } excluding the curly ket at eol
  keyList[@name=Line] // { ![\n]* } excluding the square ket at eol
}

// All Key* rules produce nodes named `Key` holding at least one `Line`:
KeyText[@name=Key] { keyText }
KeyDict[@name=Key] { keyDict }
KeyList[@name=Key] { keyList }
KeyShort[@name=Key] { keyShort }
KeyBlock[@name=Key] { block? }

// A few last Lezer details:
@skip { margin } // completely empty lines and/or indentation TAB chars
@context margin from "./context.ts"
@tokens { /* inline must have lower precedence than external */
"#!" "//" "///" "<>" "{}" "[]" "<" ">" "{" "}" "[" "]" "@" "=" }
@external propSource highlight from "./properties.ts"
